rules_version = '2';
// Правила для спільного рейтингу BUSINESS LAB.
// Читати рейтинг може будь-хто; додати можна лише новий запис правильного формату;
// змінювати й видаляти чужі (і свої) результати з сайту не можна.
service cloud.firestore {
  match /databases/{database}/documents {
    match /results/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'total', 'timeMs', 'finishedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 48
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 10
        && request.resource.data.total == 10
        && request.resource.data.timeMs is number
        && request.resource.data.timeMs >= 0 && request.resource.data.timeMs < 86400000
        && request.resource.data.finishedAt is number;
      allow update, delete: if false;
    }
  }
}
