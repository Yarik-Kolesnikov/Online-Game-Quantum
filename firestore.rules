rules_version = '2';
// Правила для спільного рейтингу BUSINESS LAB (Cloud Firestore).
// - читати рейтинг може будь-хто;
// - з сайту можна лише ДОДАТИ один новий результат правильного формату;
// - змінювати й видаляти результати з сайту не може ніхто (очищення — тільки власник
//   проєкту в Firebase Console: Firestore Database → results → ⋮ → Delete collection);
// - усі інші колекції закриті.
service cloud.firestore {
  match /databases/{database}/documents {
    match /results/{id} {
      allow read: if true;

      allow create: if id.matches('^r[a-z0-9]{6,24}$')
        && request.resource.data.keys().hasOnly(['name', 'score', 'total', 'timeMs', 'finishedAt'])
        && request.resource.data.keys().hasAll(['name', 'score', 'total', 'timeMs', 'finishedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 48
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10
        && request.resource.data.total == 10
        && request.resource.data.timeMs is number
        && request.resource.data.timeMs >= 1000
        && request.resource.data.timeMs < 86400000
        && request.resource.data.finishedAt is number
        // час завершення не може бути «з майбутнього» чи дуже старим (запас — доба на неточний годинник телефона)
        && request.resource.data.finishedAt > request.time.toMillis() - 86400000
        && request.resource.data.finishedAt < request.time.toMillis() + 86400000;

      allow update, delete: if false;
    }

    // усе інше в базі закрито
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
